#!/usr/bin/env python3
"""Fetch one fiscal profile from the user's configured Fiscal API.

The caller is responsible for checking session memory first. This helper
does not persist profiles or cache fiscal data on disk.
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import sys
import urllib.error
import urllib.request
from urllib.parse import urlsplit


API_HOST = "script.google.com"
REDIRECT_HOST = "script.googleusercontent.com"
class _NoAutoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _validate_endpoint(endpoint: str) -> str:
    parsed = urlsplit(endpoint)
    if (
        parsed.scheme != "https"
        or parsed.hostname != API_HOST
        or not re.fullmatch(r"/macros/s/[^/]+/exec/?", parsed.path)
        or parsed.query
        or parsed.fragment
    ):
        raise ValueError("FISCAL_API_ENDPOINT no es una Web App de Apps Script válida")
    return endpoint


def _get_api_key() -> str:
    direct_key = os.environ.get("FISCAL_API_KEY", "").strip()
    if direct_key:
        return direct_key

    credential_name = os.environ.get("FISCAL_API_CREDENTIAL_NAME", "").strip()
    if not credential_name:
        raise ValueError("Configura FISCAL_API_KEY o FISCAL_API_CREDENTIAL_NAME")

    credentials_path = os.environ.get("FACTURABOT_DYNAMIC_CREDENTIALS_PATH", "").strip()
    if credentials_path and credentials_path not in sys.path:
        sys.path.insert(0, credentials_path)

    try:
        from dynamic_credentials import dynamic_credential_entry
    except ImportError as exc:
        raise RuntimeError(
            "No está disponible el adaptador de credenciales de la plataforma; "
            "inyecta FISCAL_API_KEY desde la bóveda"
        ) from exc

    entry = dynamic_credential_entry(credential_name, "access_token")
    surrogate = str(entry.get("surrogate", "")).strip()
    if not surrogate.startswith("hsurr:"):
        raise RuntimeError("La bóveda no devolvió una credencial válida")
    return surrogate


def _read_json(response) -> dict:
    try:
        body = response.read()
    except http.client.IncompleteRead as exc:
        body = exc.partial or b""
    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("La respuesta de Fiscal API no contiene JSON válido") from exc


def _fetch_payload(endpoint: str, body: bytes) -> dict:
    request = urllib.request.Request(
        endpoint,
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    opener = urllib.request.build_opener(_NoAutoRedirect)
    try:
        with opener.open(request, timeout=30) as response:
            return _read_json(response)
    except urllib.error.HTTPError as exc:
        if exc.code not in (301, 302, 303, 307, 308):
            raise
        location = exc.headers.get("Location", "")

    parsed = urlsplit(location)
    if parsed.scheme != "https" or parsed.hostname != REDIRECT_HOST:
        raise ValueError("La redirección de Apps Script no es válida")
    with urllib.request.urlopen(location, timeout=30) as response:
        final_url = urlsplit(response.geturl())
        if final_url.scheme != "https" or final_url.hostname != REDIRECT_HOST:
            raise ValueError("La respuesta redirigida no es válida")
        return _read_json(response)


def main() -> int:
    parser = argparse.ArgumentParser(description="Consulta un perfil fiscal por alias")
    parser.add_argument("--alias", required=True, help="Alias exacto del perfil fiscal")
    args = parser.parse_args()
    alias = args.alias.strip()
    if not alias:
        print("error: el alias está vacío", file=sys.stderr)
        return 2

    endpoint = os.environ.get("FISCAL_API_ENDPOINT", "").strip()
    if not endpoint:
        print("error: FISCAL_API_ENDPOINT no está configurada", file=sys.stderr)
        return 2

    try:
        endpoint = _validate_endpoint(endpoint)
        api_key = _get_api_key()
        body = json.dumps({
            "action": "getFiscalProfile",
            "alias": alias,
            "apiKey": api_key,
        }).encode("utf-8")
        payload = _fetch_payload(endpoint, body)
    except urllib.error.HTTPError as exc:
        print(f"error: Fiscal API devolvió HTTP {exc.code}", file=sys.stderr)
        return 1
    except urllib.error.URLError:
        print("error: no se pudo conectar con Fiscal API", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    if not isinstance(payload, dict) or payload.get("ok") is not True:
        error = payload.get("error", "respuesta no válida") if isinstance(payload, dict) else "respuesta no válida"
        print(f"error: Fiscal API rechazó la consulta ({error})", file=sys.stderr)
        return 1

    data = payload.get("data")
    if not isinstance(data, dict) or str(data.get("alias", "")).strip().lower() != alias.lower():
        print("error: Fiscal API no devolvió el perfil solicitado", file=sys.stderr)
        return 1

    print(json.dumps(data, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
